{
    "info": {
        "_postman_id": "8f3b219e-9e7f-442a-a1b4-7b9e8a514d23",
        "name": "04. MMC - Customer RFQ & Provider Bidding Flow",
        "description": "Clean folder-wise Postman collection for the entire Quotation (RFQ) to Booking flow: Categories, Services, Provider Search, Quotation Requests, Provider Bidding, and Booking Confirmation.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "01. Category & Services",
            "item": [
                {
                    "name": "Get Categories List",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "zoneid",
                                "value": "{{zone_id}}"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{customer_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/customer/category?limit=10&offset=1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "customer",
                                "category"
                            ],
                            "query": [
                                {
                                    "key": "limit",
                                    "value": "10"
                                },
                                {
                                    "key": "offset",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "Category list fetch karne ke liye."
                    },
                    "response": []
                },
                {
                    "name": "Get Services by Category",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "zoneid",
                                "value": "{{zone_id}}"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{customer_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/customer/service/category/{{category_id}}?limit=10&offset=1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "customer",
                                "service",
                                "category",
                                "{{category_id}}"
                            ],
                            "query": [
                                {
                                    "key": "limit",
                                    "value": "10"
                                },
                                {
                                    "key": "offset",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "Selected category ke andar available services ki list."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "02. Search & Select Providers",
            "item": [
                {
                    "name": "Search Providers by Service & Location",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "zoneid",
                                "value": "{{zone_id}}"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{customer_token}}"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "service_ids[]",
                                    "value": "{{service_id}}",
                                    "type": "text"
                                },
                                {
                                    "key": "latitude",
                                    "value": "22.66215",
                                    "type": "text"
                                },
                                {
                                    "key": "longitude",
                                    "value": "75.9035",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/customer/provider/search-by-service",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "customer",
                                "provider",
                                "search-by-service"
                            ]
                        },
                        "description": "Selected service aur lat/long ke basis par available providers search karta hai."
                    },
                    "response": []
                },
                {
                    "name": "Get Provider Details",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "zoneid",
                                "value": "{{zone_id}}"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{customer_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/customer/provider-details?id={{provider_id}}",
                            "host": [
                                "{{base_url}}"
