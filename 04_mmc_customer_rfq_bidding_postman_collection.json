                                "customer",
                                "provider-details"
                            ],
                            "query": [
                                {
                                    "key": "id",
                                    "value": "{{provider_id}}"
                                }
                            ]
                        },
                        "description": "Provider ka profile, rating, reviews aur details dekhne ke liye."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "03. Quotation (RFQ) - Customer Side",
            "item": [
                {
                    "name": "Send Quotation Request to Selected Providers",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "zoneid",
                                "value": "{{zone_id}}"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{customer_token}}"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "service_id",
                                    "value": "{{service_id}}",
                                    "type": "text"
                                },
                                {
                                    "key": "category_id",
                                    "value": "{{category_id}}",
                                    "type": "text"
                                },
                                {
                                    "key": "provider_ids[]",
                                    "value": "{{provider_id}}",
                                    "type": "text",
                                    "description": "Selected Provider ID 1"
                                },
                                {
                                    "key": "service_description",
                                    "value": "Front bumper damaged, need urgent repair and painting.",
                                    "type": "text"
                                },
                                {
                                    "key": "booking_schedule",
                                    "value": "2026-09-25 11:00:00",
                                    "type": "text"
                                },
                                {
                                    "key": "service_address_id",
                                    "value": "6",
                                    "type": "text"
                                },
                                {
                                    "key": "car_model",
                                    "value": "Hyundai Creta 2022",
                                    "type": "text"
                                },
                                {
                                    "key": "car_registration_number",
                                    "value": "MH 12 AB 1234",
                                    "type": "text"
                                },
                                {
                                    "key": "damage_description",
                                    "value": "Right side bumper scratch and crack.",
                                    "type": "text"
                                },
                                {
                                    "key": "car_image",
                                    "type": "file",
                                    "src": []
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/customer/post",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "customer",
                                "post"
                            ]
                        },
                        "description": "Customer selected providers ko quotation request bhejta hai. Response me 'post_id' milti hai."
                    },
                    "response": []
                },
                {
                    "name": "Get My Quotation Requests List",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{customer_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/customer/post?limit=10&offset=1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "customer",
                                "post"
                            ],
                            "query": [
                                {
                                    "key": "limit",
                                    "value": "10"
                                },
                                {
                                    "key": "offset",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "Customer ki sabhi requests aur aane wale quotes ka count."
                    },
                    "response": []
                },
                {
                    "name": "Get Received Quotes from Providers for a Post",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{customer_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/customer/post/bid?post_id={{post_id}}&limit=10&offset=1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "customer",
                                "post",
                                "bid"
                            ],
                            "query": [
                                {
                                    "key": "post_id",
                                    "value": "{{post_id}}"
                                },
                                {
                                    "key": "limit",
                                    "value": "10"
                                },
                                {
                                    "key": "offset",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "Providers ke quotes (offered_price, notes, provider details) compare karne ke liye."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "04. Quotation (Bidding) - Provider Side",
            "item": [
                {
                    "name": "Provider: View New Quotation Requests",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{provider_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/provider/post?status=new_request&limit=10&offset=1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "provider",
                                "post"
                            ],
                            "query": [
                                {
                                    "key": "status",
                                    "value": "new_request"
                                },
                                {
                                    "key": "limit",
                                    "value": "10"
                                },
                                {
                                    "key": "offset",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "Provider panel me new requests dekhne ke liye."
                    },
                    "response": []
                },
                {
                    "name": "Provider: View Request Details (Car & Damage Info)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{provider_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/provider/post/details/{{post_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "provider",
                                "post",
                                "details",
                                "{{post_id}}"
                            ]
                        },
                        "description": "Customer ka car model, photos, damage description dekhne ke liye."
                    },
                    "response": []
                },
                {
                    "name": "Provider: Submit Price Quote (Bid)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{provider_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"post_id\": \"{{post_id}}\",\n    \"offered_price\": 1200,\n    \"provider_note\": \"Work will be completed in 2 hours with genuine parts.\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/provider/post/bid",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "provider",
                                "post",
                                "bid"
                            ]
                        },
                        "description": "Provider customer ko apna price quote bhejta hai."
                    },
                    "response": []
                },
                {
                    "name": "Provider: View My Placed Quotes",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{provider_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/provider/post?status=placed_offer&limit=10&offset=1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "provider",
                                "post"
                            ],
                            "query": [
                                {
                                    "key": "status",
                                    "value": "placed_offer"
                                },
                                {
                                    "key": "limit",
                                    "value": "10"
                                },
                                {
                                    "key": "offset",
                                    "value": "1"
                                }
                            ]
                        },
                        "description": "Provider ne jo quotes bhej rakhe hain unki list."
                    },
                    "response": []
                },
                {
                    "name": "Provider: Withdraw Price Quote",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{provider_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"post_id\": \"{{post_id}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/provider/post/bid/withdraw",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "provider",
                                "post",
                                "bid",
                                "withdraw"
                            ]
                        },
                        "description": "Bheja gaya quote wapas lene ke liye."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "05. Booking Confirmation",
            "item": [
                {
                    "name": "Confirm Booking (Cash After Service)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "zone-id",
                                "value": "{{zone_id}}"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{customer_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"post_id\": \"{{post_id}}\",\n    \"provider_id\": \"{{provider_id}}\",\n    \"payment_method\": \"cash_after_service\",\n    \"zone_id\": \"{{zone_id}}\",\n    \"service_location\": \"customer\",\n    \"service_schedule\": \"2026-09-25 11:00:00\",\n    \"booking_type\": \"normal\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/customer/booking/request/send",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "customer",
                                "booking",
                                "request",
                                "send"
                            ]
                        },
                        "description": "Cash payment ke sath quote accept karke direct booking create karna."
                    },
                    "response": []
                },
                {
                    "name": "Confirm Booking (Wallet Payment)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "zone-id",
                                "value": "{{zone_id}}"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{customer_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"post_id\": \"{{post_id}}\",\n    \"provider_id\": \"{{provider_id}}\",\n    \"payment_method\": \"wallet_payment\",\n    \"zone_id\": \"{{zone_id}}\",\n    \"service_location\": \"customer\",\n    \"service_schedule\": \"2026-09-25 11:00:00\",\n    \"booking_type\": \"normal\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/customer/booking/request/send",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "customer",
                                "booking",
                                "request",
                                "send"
                            ]
                        },
                        "description": "Wallet payment ke sath booking create karna."
                    },
                    "response": []
                },
                {
                    "name": "Track Booking Status",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "zone-id",
                                "value": "{{zone_id}}"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{customer_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/customer/booking/track/{{booking_readable_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "customer",
                                "booking",
                                "track",
                                "{{booking_readable_id}}"
                            ]
                        },
                        "description": "Booking status track karne ke liye."
                    },
                    "response": []
                }
